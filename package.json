{
  "name": "vocab-sprint",
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "format": "biome format",
    "format:fix": "biome format --fix",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "db:diff": "bun apps/db/scripts/diff.ts",
    "postinstall": "git config diff.sqlite3.textconv \"echo .dump | sqlite3\" && git config diff.sqlite3.cachetextconv true"
  }
}
